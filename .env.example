# =============================================================================
# PrepDesk / CATPrep — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure the values for your environment.
# DO NOT commit real secrets or production credentials to source control.

# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.onrender.com

# Security & Authentication
# Initial password for the primary administrator account (madhav) on first database setup.
# Passwords are encrypted with bcrypt (12 rounds) and never stored in plaintext.
ADMIN_INITIAL_PASSWORD=SetYourStrongAdminPasswordHere

# Secret key for signing session tokens / cookies (generate a 64+ char random hex string)
SESSION_SECRET=generate_a_random_64_character_hex_secret_key_here

# Google Gemini AI API Configuration
# Used for server-side VARC vocabulary lookup, test generation, and personalized study assistant.
GEMINI_API_KEY=your_gemini_api_key_here

# Email & 2FA OTP Delivery (SMTP Primary with Resend Fallback)
# Option 1: Direct SMTP Configuration (Recommended for custom domains & institutional relays)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_or_smtp_token
SMTP_FROM="PrepDesk Security" <no-reply@yourdomain.com>

# Option 2: Resend API Configuration (Fallback provider)
RESEND_API_KEY=re_your_resend_api_key_here

